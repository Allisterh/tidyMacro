^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$

# Exclude entire inst folder from the build tarball
^inst$
^pkgdown$
^vignettes$
^docs$
^_site$
^_quarto\.yml$

# Exclude xlsx from data/ (only .rda/.rds/.R allowed there)
^data/.*\.xlsx$
^_pkgdown\.yml$
^CLAUDE\.md$
^CODEX\.md$
^AGENTS\.md$
^\.claude$
^\.claude/
^\.codex$
^\.codex/

# Compiler temporary files can remain after an interrupted build.
^src/.*\.o\.tmp$
^src/.*\.o-.*\.tmp$
^src/.*-[0-9a-f]+\.o\.tmp$

# Compiled objects must never ship in the tarball.
^src/.*\.(o|so|dll|dylib)$
^\.DS_Store$
^.*/\.DS_Store$
